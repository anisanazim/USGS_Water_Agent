# Base URL for OpenAI-compatible proxies
# OPENAI_BASE_URL=https://api.ai.it.ufl.edu

# OpenAI API key for the query planning loop
# OPENAI_API_KEY=

# Model name to use for planning loop (default: gpt-5.6-luna)
# OPENAI_MODEL=gpt-5.6-luna

# USGS Water Data API key for elevated rate limits (get a key at https://api.waterdata.usgs.gov/signup/)
# USGS_API_KEY=

# USGS OGC API version endpoint (default: v0)
# USGS_API_VERSION=v0

# Base URL for USGS OGC API (default: https://api.waterdata.usgs.gov/ogcapi)
# USGS_OGC_BASE_URL=https://api.waterdata.usgs.gov/ogcapi

# Base URL for USGS discrete samples API (default: https://api.waterdata.usgs.gov/samples-data)
# USGS_SAMPLES_BASE_URL=https://api.waterdata.usgs.gov/samples-data

# Interval in seconds between process.log heartbeats (default: 20.0)
# HEARTBEAT_INTERVAL_SECONDS=20.0

# Overall total request wait cap in seconds (default: 300.0)
# REQUEST_DEADLINE_SECONDS=300.0

# Timeout for continuous OGC API requests in seconds (default: 15.0)
# USGS_REQUEST_TIMEOUT=15.0

# Timeout for discrete samples API requests in seconds (default: 240.0)
# USGS_SAMPLES_TIMEOUT=240.0

# Maximum retry attempts for transient errors (default: 2)
# USGS_MAX_ATTEMPTS=2

# Maximum concurrent warm-up requests across all stations (default: 3)
# MAX_WARMUPS=3

# Whether background keep-warm loop is enabled (default: true)
# KEEPWARM_ENABLED=true

# Interval in seconds between keep-warm rounds (default: 300.0)
# KEEPWARM_INTERVAL_SECONDS=300.0

# Target stations and pcodes for keep-warm pings (default: USGS-0423205010:00400,00403)
# KEEPWARM_TARGETS=USGS-0423205010:00400,00403

# Maximum items to inline in chat reply before referencing only the artifact (default: 0)
# INLINE_ITEMS_MAX=0

# Consecutive failure threshold before tripping circuit breaker (default: 5)
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Recovery probe timeout in seconds for open circuit breaker (default: 30.0)
# CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30.0
